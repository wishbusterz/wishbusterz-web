{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wishbusterz-web",
  "compatibility_date": "2026-08-02",

  // Everything in ./public is served as a static site.
  // There is no Worker script — this is assets only.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },

  // Live on the apex domain. custom_domain makes Cloudflare create the
  // DNS record and the TLS certificate for us.
  "routes": [
    { "pattern": "therustylamp.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }
}
